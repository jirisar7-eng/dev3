# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Secondary Gemini key for fallback rotation
GEMINI_API_KEY_2="MY_SECONDARY_GEMINI_API_KEY"

# Fallback Groq API key for llama-3.3-70b-versatile
GROQ_API_KEY="MY_GROQ_API_KEY"

# Grok / xAI API key for AI Audit Analyst
XAI_API_KEY="MY_XAI_API_KEY"

# OpenAI / Groq compatible Base URL for Playwright Midscene E2E AI Tests
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string via Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/tatovacesta_dev3?schema=public"

# JWT_SECRET: Secret key for Auth JWT tokens
JWT_SECRET="dev3_super_secret_jwt_key_tatovacesta"

# ADMIN_INITIAL_PASSWORD: Initial password for DEV admin account creation (sarji@seznam.cz)
ADMIN_INITIAL_PASSWORD="ChangeMeInDev123!"

# GITHUB_PUBLISHER CONFIGURATION
# GITHUB_TOKEN: Personal Access Token with repo access (used server-side only for git push)
GITHUB_TOKEN=""
# GITHUB_REPOSITORY: Repository in owner/repo format
GITHUB_REPOSITORY="jirisar7-eng/dev3"
# GITHUB_BRANCH: Target git branch for push
GITHUB_BRANCH="main"

# SMTP Configuration for Email Notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# e-Sbírka REST API Configuration
ESBIRKA_API_KEY=""
ESBIRKA_BASE_URL="https://www.esbirka.cz/api/v1"

# WEBHOOK_SECRET: Secret key for GitHub auto-deploy webhook authentication (/api/system/webhook-deploy)
WEBHOOK_SECRET=""

# Vercel DNS Management
VERCEL_API_TOKEN=""
VERCEL_DOMAIN="tatovacesta.cz"

# Mailcow Email Server Integration
# Public domain of Mailcow
MAILCOW_PUBLIC_URL="https://mail.tatovacesta.cz"
MAILCOW_URL="https://mail.tatovacesta.cz"
# Internal URL / IP for local VPS VPS Docker bridge networking (bypasses NAT hairpin timeout on VPS)
MAILCOW_INTERNAL_URL="https://172.22.1.14"
MAILCOW_INTERNAL_IP="172.22.1.14"
# Mailcow Read/Write API Key
MAILCOW_API_KEY=""

# Podman / Docker REST API Configuration for VPS Management (/admin/vps)
PODMAN_API_URL="https://10.211.2.130:9090"
DOCKER_HOST="https://10.211.2.130:9090"
PODMAN_API_TOKEN=""

