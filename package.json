    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-pages": "tsx prisma/seed-pages.ts",
    "db:seed-articles": "tsx prisma/seed-articles.ts"
  },
