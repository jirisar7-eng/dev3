    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
