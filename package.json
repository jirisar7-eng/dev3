{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-pages": "tsx prisma/seed-pages.ts",
    "db:seed-articles": "tsx prisma/seed-articles.ts",
    "test": "node scripts/test-runner.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
