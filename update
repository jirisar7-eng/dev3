#!/bin/bash

set -e

PROJECT="/var/www/tatovacesta_dev3"

cd "$PROJECT"

echo "=========================================="
echo "       DEV3 UPDATE WORKFLOW"
echo "=========================================="

echo
echo "=== 1. KONTROLA VĚTVE ==="

CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" != "main" ]; then
    echo "CHYBA: Nejsme na main."
    echo "Aktuální větev: $CURRENT_BRANCH"
    exit 1
fi

echo "Aktuální větev: main"

echo
echo "=== 2. FETCH GITHUB ==="

git fetch origin --prune

echo
echo "=== 3. KONTROLA STAVU ==="

LOCAL=$(git rev-parse main)
REMOTE=$(git rev-parse origin/main)

echo "LOCAL : $LOCAL"
echo "REMOTE: $REMOTE"

echo
echo "=== COMMITY POUZE NA VPS ==="
git log --oneline origin/main..main || true

echo
echo "=== COMMITY POUZE NA GITHUBU ==="
git log --oneline main..origin/main || true

echo
echo "=== 4. SYNCHRONIZACE S GITHUB ==="

if [ "$LOCAL" != "$REMOTE" ]; then

    echo "Main není synchronizovaný."

    echo "Provádím rebase na origin/main..."

    git rebase origin/main

fi

echo
echo "=== 5. KONTROLA PRACOVNÍHO STROMU ==="

git status --short

echo
echo "=== 6. COMMIT VŠECH ZMĚN ==="

if [ -n "$(git status --porcelain)" ]; then

    git add .

    git commit -m "chore: update dev3 $(date '+%Y-%m-%d %H:%M:%S')"

    echo "Změny byly commitnuty."

else

    echo "Žádné nové změny."

fi

echo
echo "=== 7. PUSH MAIN ==="

git push origin main

echo
echo "=== 8. FINÁLNÍ KONTROLA GITHUB ==="

git fetch origin

LOCAL=$(git rev-parse main)
REMOTE=$(git rev-parse origin/main)

echo "LOCAL MAIN : $LOCAL"
echo "REMOTE MAIN: $REMOTE"

if [ "$LOCAL" != "$REMOTE" ]; then

    echo
    echo "=========================================="
    echo " CHYBA: MAIN NENÍ SYNCHRONIZOVANÝ"
    echo "=========================================="

    exit 1

fi

echo
echo "=== 9. LINT ==="

npm run lint

echo
echo "=== 10. BUILD ==="

npm run build

echo
echo "=== 11. FINÁLNÍ GIT STATUS ==="

git status

echo
echo "=========================================="
echo "       UPDATE ÚSPĚŠNĚ DOKONČEN"
echo "=========================================="

echo
echo "GitHub main:"
echo "$LOCAL"

echo
echo "Lint: PASS"
echo "Build: PASS"

echo
echo "Produkce nebyla změněna."

echo
echo "Další krok:"
echo "update-prod3"

echo
